    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "google-auth-library": "^10.0.0",
    "googleapis": "^166.0.0",
    "googleapis-common": "8.0.3",
    "idb": "^8.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
