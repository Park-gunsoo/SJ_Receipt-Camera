# Never commit real secrets. See SETUP.md.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=
DB_POOL_SIZE=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded; separate from NEXTAUTH_SECRET
TOKEN_ENCRYPTION_KEY=
# Comma-separated invited, verified Google email addresses. Empty = no access.
TESTER_EMAILS=
GCP_PROJECT_ID=
GCS_BUCKET=
TASKS_LOCATION=asia-northeast1
TASKS_QUEUE=sj-receipts
TASK_SERVICE_ACCOUNT_EMAIL=
# Cloud Run processing origin, separate from the Vercel website origin.
WORKER_BASE_URL=
# Vercel → Google Workload Identity Federation (no long-lived service key).
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Optional legacy/local fallback; never NEXT_PUBLIC.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local only; Cloud Run uses an attached service account instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
# Set explicitly before allowing uploads; not marketed as a public free plan.
DAILY_RECEIPT_LIMIT=100
DAILY_OCR_LIMIT=100
MAX_JOB_ATTEMPTS=5
MAX_UPLOAD_MB=12
